class Menu:
    def __init__(self, screen, items, font, font_color, select_color,width,height):
        self.screen = screen
        self.items = items
        self.font = font
        self.font_color = font_color
        self.select_color = select_color
        self.current_item = 0
        self.menu_rects = []
        self.dropdown_open = False
        self.menu_pos = (screen.get_width() - width, 10)  # Position of the menu button
        self.menu_size = (width, height)  # Size of the menu button
        self.dropdown_rect = pygame.Rect(self.menu_pos[0], self.menu_pos[1] + self.menu_size[1], width, 60 * len(items))  # Dropdown menu area

    def draw(self):
        #self.screen.fill(CIndex.BLACK)
        # Draw menu button
        menu_button = pygame.Rect(self.menu_pos, self.menu_size)
        pygame.draw.rect(self.screen, CIndex.BLACK, menu_button)
        menu_label = self.font.render("Menu", True, CIndex.WHITE)
        self.screen.blit(menu_label, (self.menu_pos[0] + 10, self.menu_pos[1] + 5))

        if self.dropdown_open:
            pygame.draw.rect(self.screen, CIndex.BLACK, self.dropdown_rect)  # Draw dropdown background
            self.menu_rects = []
            for index, (text, _) in enumerate(self.items):
                label = self.font.render(text, True, self.font_color if index != self.current_item else self.select_color)
                width = label.get_width()
                height = label.get_height()
                pos_x = self.dropdown_rect.left + (self.dropdown_rect.width // 2) - (width // 2)
                pos_y = self.dropdown_rect.top + 10 + (index * (height + 10))
                self.screen.blit(label, (pos_x, pos_y))
                self.menu_rects.append(pygame.Rect(pos_x, pos_y, width, height))

    def handle_mouse_click(self, pos, control_vars,parsecs):
        menu_button = pygame.Rect(self.menu_pos, self.menu_size)
        if menu_button.collidepoint(pos):
            self.dropdown_open = not self.dropdown_open
            return control_vars, parsecs
        
        if self.dropdown_open:
            if not self.dropdown_rect.collidepoint(pos):
                self.dropdown_open = False
                return control_vars, parsecs
            for index, rect in enumerate(self.menu_rects):
                if rect.collidepoint(pos):
                    item_number = self.items[index][1]
                    control_vars, parsecs = self.execute_action(item_number, control_vars)

        print (control_vars,parsecs)
        return control_vars, parsecs

    def handle_mouse_wheel(self, y):
        if self.dropdown_open:
            self.current_item = (self.current_item - y) % len(self.items)

    def execute_action(self, item_number, control_vars):
        actions = {
            0: action_0,
            1: action_1,
            2: action_2,
            3: action_3,
            4: action_4,
            5: action_5,
            6: action_6,
            7: action_7,
            8: action_8,
            9: action_9
        }
        action = actions.get(item_number, lambda: print(f"No action for item number {item_number}"))
        control_vars, parsecs = action(control_vars)
        return control_vars, parsecs


def wrap_text(text, font, max_width):
    """Splits the text into lines that fit within the specified width."""
    words = text.split(' ')
    lines = []
    current_line = []
    current_width = 0
    
    for word in words:
        word_surface = font.render(word, True, (0, 0, 0))
        word_width, word_height = word_surface.get_size()
        
        if current_width + word_width <= max_width:
            current_line.append(word)
            current_width += word_width + font.size(' ')[0]  # Add a space width
        else:
            lines.append(' '.join(current_line))
            current_line = [word]
            current_width = word_width + font.size(' ')[0]
    
    lines.append(' '.join(current_line))
    return lines

def render_text(surface, text, font, color, rect, max_width):
    """Renders the text on the surface with wrapping."""
    y = rect.top
