def find_star_by_position(sprites, x, y ):
    for star in sprites:
        variance = abs(star.pos_2d[0]-star.rect[0])/2
        if variance < 5:
            variance = 5
        if abs(star.pos_2d[0] - x) <= variance and abs(star.pos_2d[1] - y) <= variance:
            return star.HIP
    return None


